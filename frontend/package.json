{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "npm run lint && npm run typecheck && npm test",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "generate:api": "openapi-typescript ../contracts/openapi-public.json -o app/types/api.d.ts",
    "check:api": "npm run generate:api -- --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@iconify-json/lucide": "1.2.150",
    "@lezer/highlight": "1.2.5",
    "@nuxt/ui": "4.12.0",
    "@streamparser/json": "0.0.26",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "nuxt": "^4.6.3",
    "ofetch": "^1.5.1",
    "pdfjs-dist": "6.5.438",
    "tailwindcss": "4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
